{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@topolgira/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@topolgira/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../../packages/shared-types/src/**/*", "../../packages/contracts/src/**/*"]
}
